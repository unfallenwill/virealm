{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.virealm.dev/common/diagnostics.schema.json",
  "title": "Diagnostics",
  "description": "Structured diagnostic events. Context values must not contain credentials, cookies or unredacted secrets.",
  "$defs": {
    "DiagnosticLevel": {
      "type": "string",
      "enum": ["debug", "info", "warn", "error"]
    },
    "DiagnosticEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestampUnixMs", "level", "component", "code", "message"],
      "properties": {
        "timestampUnixMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "level": { "$ref": "#/$defs/DiagnosticLevel" },
        "component": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "context": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": { "maxLength": 64 },
          "additionalProperties": {
            "type": "string",
            "maxLength": 1024
          }
        }
      }
    }
  }
}
