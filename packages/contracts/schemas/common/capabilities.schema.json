{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.virealm.dev/common/capabilities.schema.json",
  "title": "Capabilities",
  "description": "Result of exercising containment primitives on the host. A version number is never treated as evidence of support.",
  "$defs": {
    "CapabilityState": {
      "type": "string",
      "enum": ["supported", "unsupported", "unavailable", "not_verified"],
      "description": "supported: exercised successfully. unsupported: the platform lacks it. unavailable: present but blocked in this session. not_verified: not exercised by this build."
    },
    "Capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "$ref": "#/$defs/CapabilityState"
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "PlatformVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor", "build"],
      "description": "Windows reports major/minor/build. macOS reports major/minor/patch from kern.osproductversion, with the patch component carried in build; osVersion carries the exact product string.",
      "properties": {
        "major": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "minor": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "build": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },
    "IntegrityLevel": {
      "type": "string",
      "enum": [
        "untrusted",
        "low",
        "medium",
        "high",
        "system",
        "protected",
        "unknown"
      ]
    },
    "PlatformInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "version",
        "architecture",
        "elevated",
        "integrityLevel"
      ],
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "version": {
          "$ref": "#/$defs/PlatformVersion"
        },
        "osVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Exact product version string, e.g. macOS \"27.0.1\". Omitted on Windows."
        },
        "architecture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "elevated": {
          "type": "boolean",
          "description": "Whether the calling process token is elevated."
        },
        "integrityLevel": {
          "$ref": "#/$defs/IntegrityLevel"
        }
      }
    },
    "ResourceLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxProcesses", "memoryLimit"],
      "properties": {
        "maxProcesses": { "$ref": "#/$defs/Capability" },
        "memoryLimit": { "$ref": "#/$defs/Capability" }
      }
    },
    "CapabilityReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "jobObject",
        "appContainer",
        "appContainerAcl",
        "restrictedToken",
        "processMitigation",
        "etw"
      ],
      "description": "The six Windows keys stay required for every platform so a v2 consumer can read any report. On macOS they report unsupported, while processGroup, unixSocket and resourceLimits describe what the host actually provides.",
      "properties": {
        "platform": { "$ref": "#/$defs/PlatformInfo" },
        "jobObject": { "$ref": "#/$defs/Capability" },
        "appContainer": { "$ref": "#/$defs/Capability" },
        "appContainerAcl": { "$ref": "#/$defs/Capability" },
        "restrictedToken": { "$ref": "#/$defs/Capability" },
        "processMitigation": { "$ref": "#/$defs/Capability" },
        "etw": { "$ref": "#/$defs/Capability" },
        "processGroup": {
          "$ref": "#/$defs/Capability",
          "description": "POSIX process-group containment. Omitted on Windows."
        },
        "unixSocket": {
          "$ref": "#/$defs/Capability",
          "description": "Unix domain socket transport with peer credential checks. Omitted on Windows."
        },
        "processIdentity": {
          "$ref": "#/$defs/Capability",
          "description": "Process identity derived from the kernel start time. Omitted on Windows."
        },
        "resourceLimits": {
          "$ref": "#/$defs/ResourceLimits",
          "description": "Per-tree process and memory limits. Omitted on Windows, where Job Object limits cover them."
        },
        "notes": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        }
      }
    }
  }
}
